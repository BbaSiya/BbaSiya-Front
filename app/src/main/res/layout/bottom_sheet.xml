<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_layout"
    android:layout_width="match_parent"
    android:layout_height="355dp"
    android:background="@drawable/background_bottom_sheet"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <TextView
        android:id="@+id/bottom_sheet_tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="종목의 발견은?"
        android:textSize="18dp"
        android:textStyle="bold"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="12dp"/>

    <ImageButton
        android:id="@+id/similar_cancel_btn"
        android:layout_width="25dp"
        android:layout_height="20dp"
        android:background="@drawable/x"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"/>

    <TextView
        android:id="@+id/bottom_sheet_tv2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/bottom_sheet_tv1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="다양한 관점에서의 투자할 종목을 탐색하고 여러 그룹의 분석을 통하여 고객의 투자에 도움이 되는 종목을 발견하여 제공하는 콘텐츠입니다.\n\n본 서비스는 당사에서 거래하는 고객 데이터를 기반으로 통계자료를 제공합니다.\n\n제공되는 종목은 투자자의 투자자성향과 투자 목적등을 반영하지 않는 단순 종목 안내이며 고객에게 맞는 투자 또는 수익 달성을 보장하지 않습니다.\n\n본 서비스는 통계 분석에 기반하여 산출되었으며, 당사 리서치 의견과는 무관함을 알려드립니다."
        android:lineBreakWordStyle="phrase"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>