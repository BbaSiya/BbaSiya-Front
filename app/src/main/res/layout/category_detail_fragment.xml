            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/main_chart_category"
                android:layout_width="0dp"
                android:layout_height="35dp"
                app:layout_constraintTop_toBottomOf="@id/main_in_chart_under"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"
                android:background="#F1F4F5">

                <TextView
                    android:id="@+id/chart_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="순위"
                    android:textColor="#908F8F"
                    android:textSize="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="13dp"/>

                <TextView
                    android:id="@+id/chart_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="종목명"
                    android:textColor="#908F8F"
                    android:textSize="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/chart_num"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="32dp"/>

                <TextView
                    android:id="@+id/chart_now_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="현재가"
                    android:textColor="#908F8F"
                    android:textSize="12dp"
                    app:layout_constraintEnd_toStartOf="@id/chart_average_change"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="46dp"/>

                <TextView
                    android:id="@+id/chart_average_change"
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:text="등락률"
                    android:textColor="#908F8F"
                    android:textSize="12dp"
                    android:gravity="right"
                    app:layout_constraintEnd_toStartOf="@id/chart_volume_power"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="30dp"/>

                <TextView
                    android:id="@+id/chart_volume_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="체결강도"
                    android:textColor="#908F8F"
                    android:textSize="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="18dp"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <ListView
                android:id="@+id/chart_lv"
                android:layout_width="match_parent"
                android:layout_height="600dp"
                app:layout_constraintTop_toBottomOf="@id/main_chart_category"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="40dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>