<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/main_selectbox_group"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="10dp">

                <ImageView
                    android:id="@+id/main_selectbox_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F1F4F5"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"/>

                <ImageView
                    android:id="@+id/main_selectbox_line"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="@id/main_selectbox_background"
                    app:layout_constraintBottom_toBottomOf="@id/main_selectbox_background"
                    app:layout_constraintRight_toRightOf="@id/main_selectbox_background"
                    app:layout_constraintLeft_toLeftOf="@id/main_selectbox_background"
                    android:layout_marginTop="9dp"
                    android:layout_marginBottom="9dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="#908F8F" />

                <ImageView
                    android:id="@+id/main_selectbox"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="@id/main_selectbox_background"
                    app:layout_constraintBottom_toBottomOf="@id/main_selectbox_background"
                    app:layout_constraintRight_toRightOf="@id/main_selectbox_background"
                    app:layout_constraintLeft_toLeftOf="@id/main_selectbox_background"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="21dp"
                    android:layout_marginEnd="21dp"
                    android:background="#FFFFFF" />

                <TextView
                    android:id="@+id/main_selectbox_tv"
                    android:layout_width="310dp"
                    android:layout_height="wrap_content"
                    android:text="고객 보유종목 중 수익률 높은 종목"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/main_selectbox"
                    app:layout_constraintTop_toTopOf="@id/main_selectbox"
                    app:layout_constraintBottom_toBottomOf="@id/main_selectbox"
                    android:layout_marginStart="12dp"/>

                <ImageButton
                    android:id="@+id/main_selectbox_btn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/down"
                    app:layout_constraintEnd_toEndOf="@id/main_selectbox"
                    app:layout_constraintTop_toTopOf="@id/main_selectbox"
                    app:layout_constraintBottom_toBottomOf="@id/main_selectbox"
                    android:layout_marginEnd="12dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/main_text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="고객님들의 보유종목 중"
                android:textSize="18dp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/main_selectbox_group"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="35dp"
                android:layout_marginStart="21dp"/>

            <TextView
                android:id="@+id/main_text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="평균수익률이 높은 종목"
                android:textColor="#F48728"
                android:textSize="18dp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/main_text1"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="21dp"/>

            <TextView
                android:id="@+id/main_text3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="은 무엇일까요?"
                android:textSize="18dp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/main_text1"
                app:layout_constraintStart_toEndOf="@id/main_text2" />

            <TextView
                android:id="@+id/main_story_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/main_text2"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginStart="21dp"
                android:text="스토리보기"
                android:textSize="14dp"/>

            <ImageButton
                android:id="@+id/main_story_btn"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/forward"
                app:layout_constraintTop_toTopOf="@id/main_story_text"
                app:layout_constraintBottom_toBottomOf="@id/main_story_text"
                app:layout_constraintStart_toEndOf="@id/main_story_text"
                android:layout_marginStart="5dp"/>

            <TextView
                android:id="@+id/main_similar_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아래 종목 중\n내가 보유한 종목과 가장 유사한 종목은?"
                android:textSize="12dp"
                app:layout_constraintTop_toBottomOf="@id/main_story_text"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="10dp"
                android:layout_marginStart="21dp"/>

            <ImageButton
                android:id="@+id/main_similar_btn"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/forward"
                app:layout_constraintBottom_toBottomOf="@id/main_similar_text"
                app:layout_constraintStart_toEndOf="@id/main_similar_text"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="2dp"/>

            <Button
                android:id="@+id/main_in_chart"
                android:layout_width="60dp"
                android:layout_height="38dp"
                android:text="국내주식"
                android:textColor="#000000"
                android:textSize="16dp"
                android:textStyle="bold"
                android:backgroundTint="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/main_similar_btn"
                app:layout_constraintStart_toStartOf="parent"
                android:padding="0dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="21dp"/>

            <Button
                android:id="@+id/main_out_chart"
                android:layout_width="60dp"
                android:layout_height="38dp"
                android:text="해외주식"
                android:textColor="#AAAAAA"
                android:textSize="16dp"
                android:textStyle="bold"
                android:backgroundTint="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/main_similar_btn"
                app:layout_constraintStart_toEndOf="@id/main_in_chart"
                android:padding="0dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"/>

            <ImageView
                android:id="@+id/main_chart_line"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:background="#DDDDDD"
                app:layout_constraintTop_toBottomOf="@id/main_in_chart"
                app:layout_constraintStart_toStartOf="@id/main_in_chart"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="6dp"
                android:layout_marginTop="2dp"/>

            <ImageView
                android:id="@+id/main_in_chart_under"
                android:layout_width="60dp"
                android:layout_height="4dp"
                android:background="#000000"
                app:layout_constraintTop_toBottomOf="@id/main_in_chart"
                app:layout_constraintStart_toStartOf="@id/main_in_chart"
                app:layout_constraintEnd_toEndOf="@id/main_in_chart" />

            <ImageView
                android:id="@+id/main_out_chart_under"
                android:layout_width="60dp"
                android:layout_height="4dp"
                android:background="#000000"
                app:layout_constraintTop_toBottomOf="@id/main_out_chart"
                app:layout_constraintStart_toStartOf="@id/main_out_chart"
                app:layout_constraintEnd_toEndOf="@id/main_out_chart"
                android:visibility="gone"/>

<!--            <ImageButton-->
<!--                android:id="@+id/main_chart_btn"-->
<!--                android:layout_width="13dp"-->
<!--                android:layout_height="13dp"-->
<!--                android:background="@drawable/down"-->
<!--                app:layout_constraintEnd_toEndOf="parent"-->
<!--                app:layout_constraintTop_toTopOf="@id/main_chart_percent"-->
<!--                app:layout_constraintBottom_toBottomOf="@id/main_chart_percent"-->
