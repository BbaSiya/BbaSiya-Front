<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_header_cl"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="10dp">

        <ImageButton
            android:id="@+id/main_back_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginleft="25dp"/>

        <TextView
            android:id="@+id/main_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="종목의 발견"
            android:textSize="23dp"
            android:textStyle="bold"
            app:layout_constraintLeft_toRightOf="@id/main_back_btn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginLeft="10dp"/>

        <ImageButton
            android:id="@+id/main_like_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toLeftOf="@id/main_info_btn"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginleft="15dp"/>

        <ImageButton
            android:id="@+id/main_info_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toLeftOf="@id/main_goto_btn"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginleft="15dp"/>

        <ImageButton
            android:id="@+id/main_goto_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginRight="15dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_selectbox_group"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        app:layout_constraintTop_toBottomOf="@id/main_header_cl">

        <ImageView
            android:id="@+id/main_selectbox_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#DDDDDD"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>

        <ImageView
            android:id="@+id/main_selectbox"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@id/main_selectbox_background"
            app:layout_constraintBottom_toBottomOf="@id/main_selectbox_background"
            app:layout_constraintRight_toRightOf="@id/main_selectbox_background"
            app:layout_constraintLeft_toLeftOf="@id/main_selectbox_background"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginLeft="20dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="고객 보유종목 중 수익률 높은 종목"
            android:textSize="18dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/main_selectbox"
            app:layout_constraintTop_toTopOf="@id/main_selectbox"
            app:layout_constraintBottom_toBottomOf="@id/main_selectbox"
            android:layout_marginStart="10dp"/>

        <ImageButton
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:layout_constraintEnd_toEndOf="@id/main_selectbox"
            app:layout_constraintTop_toTopOf="@id/main_selectbox"
            app:layout_constraintBottom_toBottomOf="@id/main_selectbox"
            android:layout_marginEnd="10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/main_text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="고객님들의 보유종목 중"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/main_selectbox_group"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="35dp"
        android:layout_marginStart="20dp"/>

    <TextView
        android:id="@+id/main_text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="평균수익률이 높은 종목"
        android:textColor="#F48728"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/main_text1"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"/>

    <TextView
        android:id="@+id/main_text3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="은 무엇일까요?"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/main_text1"
        app:layout_constraintStart_toEndOf="@id/main_text2" />

    <TextView
        android:id="@+id/main_story_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/main_text2"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:text="스토리보기"
        android:textSize="15dp"/>

    <ImageButton
        android:id="@+id/main_story_btn"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintTop_toBottomOf="@id/main_text2"
        app:layout_constraintStart_toEndOf="@id/main_story_text"
        android:layout_marginTop="8dp"
        android:layout_marginStart="5dp"/>

    <TextView
        android:id="@+id/main_similar_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="아래 종목 중\n내가 보유한 종목과 가장 유사한 종목은?"
        android:textSize="14dp"
        app:layout_constraintTop_toBottomOf="@id/main_story_text"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"/>

    <ImageButton
        android:id="@+id/main_similar_btn"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@id/main_similar_text"
        app:layout_constraintStart_toEndOf="@id/main_similar_text"
        android:layout_marginStart="5dp"/>

    <FrameLayout
        android:id="@+id/main_stock_chart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/main_similar_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="20dp"
        android:background="#DDDDDD"/>








</androidx.constraintlayout.widget.ConstraintLayout>