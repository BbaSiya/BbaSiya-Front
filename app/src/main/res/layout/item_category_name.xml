<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="45dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/item_category_name_tv"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="초고수가 선택한 중국(홍콩) 종목"
        android:textSize="16dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:singleLine="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="20dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/item_category_name_cv"
        android:layout_width="40dp"
        android:layout_height="17dp"
        app:layout_constraintTop_toTopOf="@id/item_category_name_tv"
        app:layout_constraintBottom_toBottomOf="@id/item_category_name_tv"
        app:layout_constraintStart_toEndOf="@id/item_category_name_tv"
        app:cardCornerRadius="20dp"
        android:backgroundTint="#F48728"
        android:layout_marginStart="-100dp"
        app:cardElevation="0dp"
        android:visibility="visible"
        android:layout_marginTop="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:text="NEW"
            android:textColor="#FFFFFF"
            android:textScaleX="1.1"
            android:textSize="11dp" />
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/item_category_name_now"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/done_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="20dp"
        android:visibility="visible"/>



</androidx.constraintlayout.widget.ConstraintLayout>