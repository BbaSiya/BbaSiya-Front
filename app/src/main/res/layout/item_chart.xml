<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chart_news"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        app:layout_constraintTop_toBottomOf="@id/chart_cl1"
        android:background="#FFA4A4"
        android:visibility="gone">

        <TextView
            android:id="@+id/chart_news_good"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☺️ 50%,"
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/chart_news_tv"
            android:layout_marginStart="43dp"
            android:layout_marginTop="5dp"/>

        <TextView
            android:id="@+id/chart_news_bs1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BS지수: "
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="@id/chart_news_good"
            app:layout_constraintStart_toEndOf="@id/chart_news_good"
            android:layout_marginStart="8dp"/>

        <TextView
            android:id="@+id/chart_news_bs2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10"
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="@id/chart_news_good"
            app:layout_constraintStart_toEndOf="@id/chart_news_bs1" />

        <TextView
            android:id="@+id/chart_news_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HD현대, 올 2분기 HD현대그룹 상장사 중 관심도 1위…현대중공업 뒤이어"
            android:textSize="12dp"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/chart_news_good"
            app:layout_constraintStart_toStartOf="@id/chart_news_good"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="5dp"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chart_cl1"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/chart_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textStyle="bold"
            android:textSize="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="18dp"/>

        <TextView
            android:id="@+id/chart_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HD현대 중공업"
            android:textStyle="bold"
            android:textSize="14dp"
            app:layout_constraintTop_toTopOf="@id/chart_num"
            app:layout_constraintStart_toEndOf="@id/chart_num"
            app:layout_constraintBottom_toTopOf="@id/chart_name_news"
            android:layout_marginStart="20dp"/>

        <TextView
            android:id="@+id/chart_name_news"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="최근소식"
            android:textSize="10dp"
            app:layout_constraintBottom_toBottomOf="@id/chart_num"
            app:layout_constraintStart_toEndOf="@id/chart_num"
            app:layout_constraintTop_toBottomOf="@id/chart_name"
            android:layout_marginStart="20dp"/>

        <ImageView
            android:layout_width="0dp"
            android:layout_height="1px"
            app:layout_constraintTop_toBottomOf="@id/chart_name_news"
            app:layout_constraintStart_toStartOf="@id/chart_name_news"
            app:layout_constraintEnd_toEndOf="@id/chart_name_news"
            android:background="#000000"
            android:layout_marginTop="-3px"/>

        <TextView
            android:id="@+id/chart_now_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="372,000"
            android:textStyle="bold"
            android:textSize="14dp"
            android:textColor="#005DFF"
            app:layout_constraintStart_toEndOf="@id/chart_name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="20dp"/>

        <TextView
            android:id="@+id/chart_critics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60,564"
            android:textStyle="bold"
            android:textSize="14dp"
            app:layout_constraintStart_toEndOf="@id/chart_now_price"
            app:layout_constraintEnd_toStartOf="@id/chart_average_return"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/chart_average_return"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="514.2%"
            android:textStyle="bold"
            android:textSize="14dp"
            app:layout_constraintStart_toEndOf="@id/chart_critics"
            app:layout_constraintEnd_toStartOf="@id/chart_volume_power"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/chart_volume_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="40"
            android:textSize="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="18dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>