<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    
    <TextView
        android:id="@+id/similar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="나와 가장 유사한 종목"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="47dp"/>

    <ImageButton
        android:id="@+id/similar_cancel_btn"
        android:layout_width="22dp"
        android:layout_height="20dp"
        android:background="@drawable/x"
        app:layout_constraintTop_toTopOf="@id/similar_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/similar_title"
        android:layout_marginEnd="21dp"/>

    <TextView
        android:id="@+id/similar_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="배별하"
        android:textSize="16dp"
        app:layout_constraintTop_toBottomOf="@id/similar_title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="47dp"
        android:layout_marginTop="40dp"/>

    <TextView
        android:id="@+id/similar_tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="님이"
        android:textSize="16dp"
        app:layout_constraintStart_toEndOf="@id/similar_name_tv"
        app:layout_constraintTop_toTopOf="@id/similar_name_tv"/>

    <TextView
        android:id="@+id/similar_tv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="보유하신 종목과 가장 유사한 종목은"
        android:textSize="16dp"
        app:layout_constraintStart_toStartOf="@id/similar_name_tv"
        app:layout_constraintTop_toBottomOf="@id/similar_name_tv"/>

    <TextView
        android:id="@+id/similar_company_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HD현대 중공업"
        android:textSize="28dp"
        android:textColor="#F48728"
        app:layout_constraintTop_toBottomOf="@id/similar_tv2"
        app:layout_constraintStart_toStartOf="@id/similar_tv2"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="입니다"
        android:textSize="16dp"
        app:layout_constraintStart_toEndOf="@id/similar_company_tv"
        app:layout_constraintBottom_toBottomOf="@id/similar_company_tv"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="2dp"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/similar_cv1"
        android:layout_width="0dp"
        android:layout_height="130dp"
        app:layout_constraintTop_toBottomOf="@id/similar_company_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="3px"
        app:strokeColor="#F48728"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/similar_cv_tv1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재 "
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"/>

            <TextView
                android:id="@+id/similar_cv_tv2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HD현대 중공업"
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/similar_cv_tv1"
                app:layout_constraintStart_toEndOf="@id/similar_cv_tv1"
                app:layout_constraintBottom_toBottomOf="@id/similar_cv_tv1"/>

            <TextView
                android:id="@+id/similar_cv_tv3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="의 긍정지수는 "
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/similar_cv_tv1"
                app:layout_constraintStart_toEndOf="@id/similar_cv_tv2"
                app:layout_constraintBottom_toBottomOf="@id/similar_cv_tv1"/>

            <TextView
                android:id="@+id/similar_cv_tv4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#F48728"
                app:layout_constraintTop_toTopOf="@id/similar_cv_tv1"
                app:layout_constraintStart_toEndOf="@id/similar_cv_tv3"
                app:layout_constraintBottom_toBottomOf="@id/similar_cv_tv1"/>

            <TextView
                android:id="@+id/similar_cv_tv5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="입니다"
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/similar_cv_tv1"
                app:layout_constraintStart_toEndOf="@id/similar_cv_tv4"
                app:layout_constraintBottom_toBottomOf="@id/similar_cv_tv1"/>

            <ImageView
                android:id="@+id/similar_cv_line"
                android:layout_width="0dp"
                android:layout_height="3px"
                android:background="#F48728"
                app:layout_constraintTop_toBottomOf="@id/similar_cv_tv1"
                app:layout_constraintStart_toStartOf="@id/similar_cv_tv1"
                app:layout_constraintEnd_toEndOf="@id/similar_cv_tv5"
                android:layout_marginTop="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HD현대, 올 2분기 HD현대그룹"
                app:layout_constraintTop_toBottomOf="@id/similar_cv_line"

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>






    
</androidx.constraintlayout.widget.ConstraintLayout>