<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


            <TextView
                android:id="@+id/category_tv1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="다른 사람들이 "
                android:textSize="16dp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="20dp"
                android:layout_marginStart="21dp"/>

            <TextView
                android:id="@+id/category_tv2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="선택한 종목"
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="#F48728"
                app:layout_constraintTop_toTopOf="@id/category_tv1"
                app:layout_constraintStart_toEndOf="@id/category_tv1"/>


            <TextView
                android:id="@+id/category_tv3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="은?"
                android:textSize="16dp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/category_tv2"
                app:layout_constraintStart_toEndOf="@id/category_tv2"/>

            <TextView
                android:id="@+id/category_tv4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="다양한 그룹의 종목을 발견해 보세요."
                android:textSize="12dp"
                app:layout_constraintTop_toBottomOf="@id/category_tv1"
                app:layout_constraintStart_toStartOf="@id/category_tv1"
                android:layout_marginTop="5dp"/>

            <ListView
                android:id="@+id/category_lv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/category_tv4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="30dp"
                android:divider="@color/white"/>



</androidx.constraintlayout.widget.ConstraintLayout>